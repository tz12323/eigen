# Auto-generated by mcpp v0.0.1. Do not edit by hand.
ninja_required_version = 1.11

cxx       = D$:\cbuild\registry\data\xpkgs\xim-x-llvm\20.1.7\bin\clang++.exe
cxxflags  = -std=c++23 -fprebuilt-module-path=D$:\bianchen\c\eigen\target\x86_64-pc-windows-msvc\9c7a7699c1748c66\pcm.cache -O2
ldflags   =
ar        = D$:\cbuild\registry\data\xpkgs\xim-x-llvm\20.1.7\bin\llvm-ar.exe
mcpp      = D$:\cbuild\bin\mcpp.exe
scan_deps = D$:\cbuild\registry\data\xpkgs\xim-x-llvm\20.1.7\bin\clang-scan-deps.exe

rule cp_bmi
  command = powershell -NoProfile -Command "Copy-Item -Force '$in' -Destination '$out'"
  description = STAGE $out

rule cxx_dyndep
  command = $mcpp dyndep --single --bmi-dir pcm.cache --bmi-ext .pcm --output $out $in
  description = DYNDEP $out
  restat = 1

rule cxx_module
  command = $cxx $local_includes $cxxflags $unit_cxxflags -fmodule-output=$bmi_out -c $in -o $out
  description = MOD $out
  restat = 1

rule cxx_object
  command = $cxx $local_includes $cxxflags $unit_cxxflags -c $in -o $out
  description = OBJ $out
  restat = 1

rule cxx_link
  command = $cxx $in -o $out $ldflags $unit_ldflags
  description = LINK $out

rule cxx_archive
  command = $ar rcs $out $in
  description = AR $out

rule cxx_shared
  command = $cxx -shared $in -o $out $ldflags $soname_flag $unit_ldflags
  description = SHARED $out

rule runtime_alias
  command = powershell -NoProfile -Command "Copy-Item -Force '$in' -Destination '$out'"
  description = ALIAS $out

rule cxx_scan
  command = cmd /c "$scan_deps -format=p1689 -- $cxx $local_includes $cxxflags $unit_cxxflags -c $in -o $compile_target > $out"
  description = SCAN $out

rule cxx_collect
  command = $mcpp dyndep --bmi-dir pcm.cache --bmi-ext .pcm --output $out $in
  description = COLLECT $out
  restat = 1




build bin\eigen.lib : cxx_archive

default bin\eigen.lib
